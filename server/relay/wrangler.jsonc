{
  // Agentville team relay. Deploy with `npm run deploy` (see docs/TEAM.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentville-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "ACCOUNT", "class_name": "Account" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Directory"] },
    { "tag": "v2", "new_sqlite_classes": ["Account"] }
  ]
}
