{
  "name": "agentville",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @agentville/desktop",
    "build": "npm run build -w @agentville/desktop",
    "tauri": "npm run tauri -w @agentville/desktop",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "i18n:check": "node scripts/check-i18n.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
